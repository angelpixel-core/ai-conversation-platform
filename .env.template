# ==============================================================================
# AI Conversation Platform — Canonical Environment & Secrets Template
# ==============================================================================
# This template documents all configurable environment variables across the 4
# deployment levels (Local, CI/CD, Staging, Production).
#
# Copy this file to '.env' for local development:
#   cp .env.template .env
#
# NEVER commit your actual '.env' or secret credentials to source control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Core Server
# ------------------------------------------------------------------------------
APP_NAME=ai-conversation-platform
ENVIRONMENT=local              # Options: local, test, dev, staging, production
DEBUG=false                    # Set true for verbose debug logging
LOG_LEVEL=INFO                 # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
API_HOST=0.0.0.0               # Host address for FastAPI / Uvicorn server
API_PORT=8000                  # Port for FastAPI / Uvicorn server (1-65535)

# ------------------------------------------------------------------------------
# 2. Database Persistence (Microsoft SQL Server 2022 / In-Memory)
# ------------------------------------------------------------------------------
PERSISTENCE_DRIVER=in_memory   # Options: in_memory, mssql
DB_SERVER=localhost
DB_PORT=1433                   # Port for MSSQL Server (1-65535)
DB_NAME=ChatbotDB
DB_USER=sa
DB_PASSWORD=YourStrong@Password123
# DATABASE_URL (optional explicit override, e.g. for connection string pooling):
# DATABASE_URL=mssql+pymssql://sa:YourStrong%40Password123@localhost:1433/ChatbotDB

# ------------------------------------------------------------------------------
# 3. Asynchronous Messaging Broker (RabbitMQ 3.13 / In-Memory — Canonical: BROKER_*)
# ------------------------------------------------------------------------------
MESSAGING_DRIVER=in_memory     # Options: in_memory, rabbitmq
BROKER_URL=amqp://guest:guest@localhost:5672/
BROKER_HOST=localhost
BROKER_PORT=5672               # Port for AMQP connection (1-65535)
BROKER_USER=guest
BROKER_PASSWORD=guest
BROKER_PREFETCH_COUNT=10
BROKER_EXCHANGE=ai_platform.events
BROKER_QUEUE=conversation.llm_processing.queue
BROKER_DLX_EXCHANGE=ai_platform.events.dlx
BROKER_DLQ=conversation.llm_processing.dlq
BROKER_ROUTING_KEY=conversation.message.appended

# ------------------------------------------------------------------------------
# 4. Multi-Tenancy & Policy Engine
# ------------------------------------------------------------------------------
ENABLE_TENANT_MIDDLEWARE=false # Set true to enforce X-Tenant-ID header check
DEFAULT_TENANT_ID=default-tenant

# ------------------------------------------------------------------------------
# 5. Enterprise AI Governance & Distributed Observability (OpenTelemetry)
# ------------------------------------------------------------------------------
ENABLE_OPENTELEMETRY=false     # Set true to enable W3C traceparent propagation
OTEL_SERVICE_NAME=chatbot-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ------------------------------------------------------------------------------
# 6. Large Language Model (LLM) Inference Gateway
# ------------------------------------------------------------------------------
LLM_PROVIDER=fake              # Options: fake, openai, azure_openai, anthropic
OPENAI_API_KEY=                # Required when LLM_PROVIDER=openai
OPENAI_BASE_URL=               # Optional custom base URL for OpenAI-compatible proxies
LLM_TIMEOUT_SECONDS=30.0
