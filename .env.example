# Quick-start local environment configuration
# See .env.template for exhaustive documentation and all configuration options.
# Copy this file to .env: cp .env.example .env

APP_NAME=ai-conversation-platform
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

PERSISTENCE_DRIVER=in_memory
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=ChatbotDB
DB_USER=sa
DB_PASSWORD=YourStrong@Password123

MESSAGING_DRIVER=in_memory
BROKER_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

ENABLE_TENANT_MIDDLEWARE=false
DEFAULT_TENANT_ID=default-tenant

ENABLE_OPENTELEMETRY=false
OTEL_SERVICE_NAME=chatbot-api

LLM_PROVIDER=fake
LLM_TIMEOUT_SECONDS=30.0
